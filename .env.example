BOOKING_PORT=8000
FLIGHT_PORT=50051
GRPC_API_KEY=local-development-service-key
BOOKING_DB_PASSWORD=booking-local-password
FLIGHT_DB_PASSWORD=flight-local-password
GRPC_TIMEOUT=2
GRPC_MAX_ATTEMPTS=3
